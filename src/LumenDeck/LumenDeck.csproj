<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <AssemblyName>LumenDeck</AssemblyName>
    <RootNamespace>LumenDeck</RootNamespace>
    <Version>1.1.0</Version>
    <Product>LumenDeck</Product>
    <Description>Brightness, contrast and colour temperature for every monitor, over DDC/CI.</Description>
    <Copyright>Copyright (c) LumenDeck contributors</Copyright>
    <RepositoryUrl>https://github.com/snowyukitty/LumenDeck</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AnalysisLevel>latest</AnalysisLevel>

    <!-- The icon Explorer, the taskbar and Alt-Tab show for the exe. -->
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\assets\LumenDeck.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Embedded as well as applied to the exe: the tray loads the 16px frame
         at runtime, and extracting it from the exe would depend on the file
         path on disk, which does not survive a single-file publish. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)..\..\assets\LumenDeck.ico"
                      LogicalName="LumenDeck.assets.LumenDeck.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LumenDeck.Core\LumenDeck.Core.csproj" />
  </ItemGroup>

</Project>
